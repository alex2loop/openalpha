      "@/*": [
        "../src/*"
      ],
      "@openalpha/runtime": [
        "../src/index.ts"
      ],
      "@openalpha/runtime/app": [
        "../src/app/api.ts"
      ],
      "zod": [
        "../node_modules/zod"
      ]
    }
  },
  "include": [
    "../src/markdown.d.ts",
    "../src/app/browser/browser-globals.d.ts",
    "./browser-build.ts",
    "./brief-page.ts",
    "./brief-strings.ts",
    "./build-brief.ts",
    "./build-site.ts",
    "./build-web.ts",
    "./check-browser-bundle.ts",
    "./check-brief-bundle.ts",
    "./check-research-integrity-regressions.ts",
    "./check-trading-locale.ts",
    "./check-vi-terminology.ts",
    "./evaluate-research-routing.ts",
    "./public-brief-dry-run.ts",
    "./research-*.ts",
    "./research-*/**/*.ts",
    "./sdk-embedder-smoke.ts",
    "./web-headers.ts"
  ]
}
