# Mirrors biome.json: space indent, width 2, LF, 100 columns. Change both together.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Markdown uses trailing spaces for hard line breaks, and its prose wraps at 100 by hand.
[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc}]
max_line_length = off

# config.sample.toml carries long commented example values.
[*.toml]
max_line_length = off

[Makefile]
indent_style = tab
